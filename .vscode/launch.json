{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++ 调试当前项目 (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/app",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "启用 gdb pretty-printing（STL 容器更好看）",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build current project"
    },
    {
      "name": "调试 tinyrenderer/mine",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/tinyrenderer/mine/app",
      "args": [
        "${workspaceFolder}/tinyrenderer/obj/diablo3_pose/diablo3_pose.obj",
        "${workspaceFolder}/tinyrenderer/obj/floor.obj"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/tinyrenderer/mine",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "启用 gdb pretty-printing（STL 容器更好看）",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "tinyrenderer: build"
    }
  ]
}
