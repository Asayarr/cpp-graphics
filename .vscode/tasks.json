{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "make all",
      "type": "shell",
      "command": "make",
      "args": [],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build current project",
      "type": "shell",
      "command": "${workspaceFolder}/tools/build-current.sh",
      "args": ["${file}"],
      "options": { "cwd": "${fileDirname}" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run current project",
      "type": "shell",
      "command": "${fileDirname}/app",
      "dependsOn": ["build current project"],
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": []
    },
    {
      "label": "tinyrenderer: build",
      "type": "shell",
      "command": "make",
      "args": [],
      "options": { "cwd": "${workspaceFolder}/tinyrenderer/mine" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "tinyrenderer: run",
      "type": "shell",
      "command": "make",
      "args": ["run"],
      "options": { "cwd": "${workspaceFolder}/tinyrenderer/mine" },
      "problemMatcher": []
    }
  ]
}
